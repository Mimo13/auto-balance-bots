# Runtime mode: paper | testnet | live
TRADING_MODE=paper

# Binance network for public/private clients: testnet | mainnet
BINANCE_ENV=testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Comma-separated default universe for advisor reports
ADVISOR_PAIRS=SOLUSDC,BTCUSDC,ETHUSDC,XLMUSDC

# Risk defaults
GLOBAL_USDC_RESERVE_PCT=0.25
MAX_PAIR_WEIGHT_PCT=0.45
MAX_CAPITAL_MOVE_PER_CYCLE_PCT=0.15
REBALANCE_THRESHOLD_PCT=0.07
